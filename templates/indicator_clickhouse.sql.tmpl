SELECT 'SOL'                                      AS ENTITY_LEVEL,
       toString(G_SOL_ID)                         AS ENTITY_ID,      -- TODO
       sum(ACTUAL_AMT)                            AS NUMERATOR,
       sum(PLAN_AMT)                              AS DENOMINATOR,
       sum(ACTUAL_AMT) / nullIf(sum(PLAN_AMT), 0) AS VALUE,
       count()                                    AS SOURCE_ROW_COUNT
FROM {{schema.finacle}}.TODO_TABLE
WHERE toDate(B_TXNDATE) = {p_report_date:Date}
GROUP BY ENTITY_ID
