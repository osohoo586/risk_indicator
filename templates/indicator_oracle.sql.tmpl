-- Стандарт багана: ENTITY_LEVEL, ENTITY_ID, VALUE (+ ENTITY_NAME, METRIC, NUMERATOR, DENOMINATOR, SOURCE_ROW_COUNT)
-- SOL түвшинд гаргавал runner үйл ажиллагааны SOL-уудаар Σ NUMERATOR / Σ DENOMINATOR нэгтгэнэ.
SELECT 'SOL'                                      AS ENTITY_LEVEL,
       TO_CHAR(t.SOLID)                           AS ENTITY_ID,      -- TODO
       SUM(t.ACTUAL_AMT)                          AS NUMERATOR,      -- TODO: гүйцэтгэл / тоологч
       SUM(t.PLAN_AMT)                            AS DENOMINATOR,    -- TODO: төлөвлөгөө / хуваарь
       SUM(t.ACTUAL_AMT) / NULLIF(SUM(t.PLAN_AMT), 0) AS VALUE,
       COUNT(*)                                   AS SOURCE_ROW_COUNT
FROM   {{schema.ra}}.TODO_TABLE t
WHERE  t.TXNDATE = :p_report_date
GROUP  BY t.SOLID
