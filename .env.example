# Энэ файлыг .env нэрээр хуулж, өөрийн утгуудаа бичнэ:  cp .env.example .env
# .env нь git-д орохгүй (.gitignore). Prod серверт GitLab CI/CD variables эсвэл серверийн env ашиглана.
# Oracle формат: user/password@host:port/service_name
# ClickHouse: host, HTTP port (8123 эсвэл 8443), user, password

DEV_ORACLE_RA=
DEV_ORACLE_WHOUSE=
DEV_ORACLE_ERP=
DEV_ORACLE_CEC=
DEV_ORACLE_ILO=
DEV_CH_HOST=
DEV_CH_PORT=8123
DEV_CH_USER=
DEV_CH_PASSWORD=

TEST_ORACLE_RA=
TEST_ORACLE_WHOUSE=
TEST_ORACLE_ERP=
TEST_ORACLE_CEC=
TEST_ORACLE_ILO=
TEST_CH_HOST=
TEST_CH_PORT=8123
TEST_CH_USER=
TEST_CH_PASSWORD=

# PROD-ийн утгыг хөгжүүлэгчийн компьютерт хадгалахгүй
PROD_ORACLE_RA=
PROD_ORACLE_WHOUSE=
PROD_ORACLE_ERP=
PROD_ORACLE_CEC=
PROD_ORACLE_ILO=
PROD_CH_HOST=
PROD_CH_PORT=8123
PROD_CH_USER=
PROD_CH_PASSWORD=

# Audit-д бичигдэх нэр (хоосон бол компьютерийн хэрэглэгчийн нэр)
RI_USER=
